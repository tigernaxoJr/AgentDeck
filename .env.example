# 複製為 .env 後填入。.env 已被 .gitignore 排除，請勿提交。

# 存取金鑰：前端 Console 右上角輸入同一組值。可用 `openssl rand -hex 32` 產生。
ANTIGRAVITY_API_KEY=

# CLI 執行檔名稱或路徑（預設 agy）
ANTIGRAVITY_CLI_BIN=agy

# 本機直接執行後端時的選項（Docker 內由 nginx 代理，不需更改）
# HOST=127.0.0.1
# PORT=3000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TUTOR_DATA_DIR=./tutor_data
